{
  "name": "@one/icons",
  "version": "0.1.0",
  "description": "One's icon library.",
  "license": "MIT",
  "author": "dotm4x",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotm4x/one.git",
    "directory": "packages/icons"
  },
  "homepage": "https://github.com/dotm4x/one#readme",
  "bugs": {
    "url": "https://github.com/dotm4x/one/issues"
  },
  "keywords": [
    "icons",
    "react",
    "design-system",
    "ui",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('source/icons/components', { recursive: true, force: true }); fs.rmSync('source/generated.ts', { force: true });\"",
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run generate && npm run typecheck && tsup",
    "dev": "npm run generate && tsup --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
