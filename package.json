{
  "name": "notable-workspace",
  "description": "A collection of thoughtfully crafted, expressive components for the web.",
  "license": "MIT",
  "author": "dotm4x",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotm4x/notable.git"
  },
  "homepage": "https://github.com/dotm4x/notable",
  "bugs": {
    "url": "https://github.com/dotm4x/notable/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @notable/sandbox dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
